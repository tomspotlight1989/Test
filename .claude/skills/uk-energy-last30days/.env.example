# Copy to .env in this directory and fill in whichever credentials you have.
# Every variable here is optional — Reddit, Hacker News, GitHub, arXiv,
# Polymarket, Bluesky, GOV.UK, UK trade press, Techmeme, and StockTwits all
# work with none of these set. See docs/SOURCES.md and docs/SETUP.md.

# Raises GitHub's search API rate limit from 10/min to 30/min (unauthenticated
# GitHub search is otherwise the flakiest of the zero-config sources).
GITHUB_TOKEN=

# X / Twitter — recent search v2 (developer.x.com), needs a project with
# at least Basic API access.
X_BEARER_TOKEN=

# YouTube Data API v3 key (console.cloud.google.com).
YOUTUBE_API_KEY=

# Perplexity Sonar API key (perplexity.ai/settings/api) — used for one extra
# AI-grounded, cited summary per topic.
PERPLEXITY_API_KEY=

# Brave Search API key (brave.com/search/api) — general web fallback.
BRAVE_API_KEY=

# ScrapeCreators API key (scrapecreators.com) — powers TikTok, Instagram,
# Threads, Pinterest, LinkedIn, and Xiaohongshu, none of which have an
# official public search API of their own.
SCRAPECREATORS_API_KEY=

# Override where generated guides/snapshots are saved (default: <repo>/guides).
UK_ENERGY_SAVE_DIR=
